# Copy to .env and fill in your values. Never commit .env.

# Competition runtime. Take the address and the key from the competition site.
SCENARIO_RUNTIME_ENDPOINT=bluesec.team:443
SCENARIO_RUNTIME_TOKEN=replace-with-your-key
SCENARIO_RUNTIME_VERIFY_TLS=true
# Optional: choose a specific competition arena instead of the currently open default.
# SCENARIO_RUNTIME_ARENA=practice

GRPC_DNS_RESOLVER=native
REMOTE_RUN_LABEL=my-agent
# Shown next to your runs in the competition interface.
AGENT_NAME=my-agent

# OpenAI-compatible LLM provider. All three are required.
LLM_BASE_URL=https://provider.example/v1
LLM_API_KEY=replace-with-your-key
LLM_DEFAULT_MODEL=provider/model-name

# Optional limits.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_COMPLETION_TOKENS=16384
LLM_MAX_STEP_RETRIES=3
BLUESEC_AGENT_MAX_STEPS=100
